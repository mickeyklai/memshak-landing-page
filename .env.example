# Workflow: CONTRIBUTING.md (partials, Studio, Netlify Dev)
#
# Netlify: Site settings → Environment variables (and local `netlify dev`)
SANITY_PROJECT_ID=
# Optional
# SANITY_DATASET=production
# SANITY_API_VERSION=2024-01-01
# SANITY_USE_CDN=false
# Canonical origin for sitemap, RSS, and edge SEO (Netlify sets URL automatically if omitted)
# SITE_ORIGIN=https://memshak.co.il

# Sanity Studio (folder studio/) — create project at sanity.io/manage
# SANITY_STUDIO_PROJECT_ID=same_as_SANITY_PROJECT_ID
