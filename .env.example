# Copy to `.env` in the repo root (see scripts/publish-daily-blog.cjs).
# Only these four are required for the daily blog publisher:
SANITY_PROJECT_ID=
SANITY_API_WRITE_TOKEN=
GROQ_API_KEY=
HF_TOKEN=
# Images use router.huggingface.co (Inference Providers). If generation fails, the script still publishes the post without mainImage.
# Force skip HF: npm run publish:daily-blog -- --no-image --next-slug

# Workflow: CONTRIBUTING.md (partials, Studio, Netlify Dev)
#
# Netlify — site environment (not used by publish script defaults):
# SANITY_PROJECT_ID=   # required for `/blog/` + functions — in Netlify UI enable scope "Functions" (not Build-only), then redeploy
# SITE_ORIGIN=https://www.maliapp.co.il
